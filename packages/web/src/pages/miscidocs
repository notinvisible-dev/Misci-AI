  .logo span{color:var(--accent)}
  nav .nav-right{margin-left:auto;display:flex;gap:1.5rem;align-items:center}
  nav a{color:var(--text-dimmer);text-decoration:none;font-size:.85rem;transition:color .2s}
  nav a:hover{color:var(--text)}

  .layout{display:flex;padding-top:56px;min-height:100vh}

  .sidebar{position:fixed;top:56px;left:0;bottom:0;width:var(--sidebar-w);padding:1.5rem 1.5rem 2rem 2rem;overflow-y:auto;border-right:1px solid var(--border);background:var(--bg);transition:background .3s,border-color .3s}
  .sidebar-group{margin-bottom:1.5rem}
  .sidebar-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text-dimmer);font-weight:600;margin-bottom:.5rem;padding-left:.5rem}
  .sidebar-link{display:block;padding:.35rem .5rem;border-radius:6px;font-size:.85rem;color:var(--text-dim);text-decoration:none;transition:all .15s;margin-bottom:1px}
  .sidebar-link:hover{color:var(--text);background:var(--accent-glow)}
  .sidebar-link.active{color:var(--accent);background:var(--accent-glow);font-weight:500}

  .main{margin-left:var(--sidebar-w);flex:1;max-width:780px;padding:3rem 3.5rem 6rem}

  h1{font-family:'Space Grotesk',system-ui,sans-serif;font-size:2rem;font-weight:700;letter-spacing:-.03em;color:var(--text);margin-bottom:.5rem}
  h2{font-family:'Space Grotesk',system-ui,sans-serif;font-size:1.4rem;font-weight:600;letter-spacing:-.02em;color:var(--text);margin:3rem 0 .75rem;padding-top:1rem;border-top:1px solid var(--border)}
  h3{font-family:'Space Grotesk',system-ui,sans-serif;font-size:1.1rem;font-weight:600;color:var(--text);margin:2rem 0 .5rem}
  p{color:var(--text-dim);margin-bottom:1rem;font-size:.925rem}
  .subtitle{color:var(--text-dimmer);font-size:1rem;margin-bottom:2.5rem}
  a{color:var(--accent);text-decoration:none}
  a:hover{text-decoration:underline}
  strong{color:var(--text);font-weight:500}

  code{font-family:'JetBrains Mono',monospace;font-size:.825rem;background:var(--bg-code);padding:.15rem .4rem;border-radius:4px;color:var(--text);border:1px solid var(--border);transition:background .3s,border-color .3s}
  pre{background:var(--bg-code);border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem 1.5rem;overflow-x:auto;margin:1rem 0 1.5rem;font-size:.825rem;line-height:1.7;transition:background .3s,border-color .3s}
  pre code{background:none;padding:0;border:none;font-size:inherit}
  .prompt-char{color:var(--accent);user-select:none}

  ul,ol{color:var(--text-dim);margin:0 0 1.25rem 1.25rem;font-size:.925rem}
  li{margin-bottom:.35rem}
  li::marker{color:var(--text-dimmer)}

  .callout{padding:1rem 1.25rem;border-radius:var(--radius);margin:1.25rem 0;font-size:.875rem;border:1px solid}
  .callout-info{background:var(--accent-glow);border-color:rgba(91,76,204,.15);color:var(--text-dim)}
  .callout-info strong{color:var(--accent)}
  .callout-warn{background:rgba(234,179,8,.06);border-color:rgba(234,179,8,.2);color:var(--text-dim)}
  .callout-warn strong{color:#a16207}
  @media(prefers-color-scheme:dark){.callout-warn strong{color:#eab308}}

  table{width:100%;border-collapse:collapse;margin:1rem 0 1.5rem;font-size:.875rem}
  th{text-align:left;color:var(--text-dimmer);font-weight:500;padding:.5rem .75rem;border-bottom:1px solid var(--border)}
  td{padding:.5rem .75rem;border-bottom:1px solid var(--border);color:var(--text-dim)}

  .sidebar-toggle{display:none;background:none;border:none;color:var(--text);font-size:1.25rem;cursor:pointer;padding:.25rem}
  @media(max-width:900px){
    .sidebar{transform:translateX(-100%);transition:transform .25s}
    .sidebar.open{transform:translateX(0);z-index:99}
    .sidebar-toggle{display:block}
    .main{margin-left:0;padding:2rem 1.5rem 4rem}
  }
